# Staged, NOT installed, NOT enabled. See local-models/QWEN_FLASH_CONTROL_PLANE.md.
#
# Install (Phase 0, must happen when no session depends on this server):
#   systemctl --user stop qwen38-flash-native-mtp.service
#   ln -sfn $PWD/systemd/qwen-flash.service ~/.config/systemd/user/qwen-flash.service
#   systemctl --user daemon-reload
#   systemctl --user start qwen-flash.service
#
# Intentionally NOT enabled with `enable`: until the manager knows the `qwen-flash` mode exists,
# auto-start on login competes with `pi-inference team|studio|ds4` for the one card. Ownership is
# the manager's job (Phase 1), not the unit file's.
#
# Intentionally NO Conflicts=pi-llama-router.service. Conflicts makes systemd stop this server
# when another owner starts — so `pi-inference team` would silently kill a live 262K agent session
# and then report a successful transition, because the manager does not look at this unit. A
# silent session kill is worse than the current OOM-window failure, which at least fails loudly.
# Phase 1 replaces both failure modes with an owned transition that refuses up front.

[Unit]
Description=Qwen3.8 Flash Next (qwen-flash): Q4 native 262K, MTP + vision
Documentation=file:/media/NVME_DATA/MOUNTS/Models/qwen-3.8-flash/DEPLOYMENT.md
Documentation=file:%h/Develop/MACHINE_LEARNING/local-models/QWEN_FLASH_CONTROL_PLANE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/media/NVME_DATA/MOUNTS/Models/qwen-3.8-flash
ExecStart=/media/NVME_DATA/MOUNTS/Models/qwen-3.8-flash/run-q4-native-mtp.sh

# Explicit, not inherited from an interactive shell. The runtime is a pinned llama.cpp PR build
# and a project-local fixed ROCr; both are set inside run-mtp-pr-test.sh, and HSA_ENABLE_SDMA is
# required by the ROCr ring-tracker fix in that prefix.
Environment=HSA_ENABLE_SDMA=1

# ~2 min model + draft + projector load at 262,144 tokens, generous start deadline.
Restart=on-failure
RestartSec=15
TimeoutStartSec=900
TimeoutStopSec=120
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
LockPersonality=true

# Left off pending one verified start with them enabled: the process mmaps 88 GiB of model from
# /media/NVME_DATA and needs writable page-cache access for lazy mmap. Verify with
# `systemd-analyze security qwen-flash.service` plus a real 100K request before adding:
#   ProtectSystem=strict
#   ProtectHome=read-only
#
# No MemoryMax on purpose: peak RSS measured 48,127 MiB on a real 100K request, and the 24 GiB
# prompt cache is sized for the full native context. A cap here turns a slow request into SIGKILL.

[Install]
WantedBy=default.target
